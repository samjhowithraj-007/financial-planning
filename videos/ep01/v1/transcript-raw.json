[
{
"start": 8.06,
"end": 8.32,
"text": ""
},
{
"start": 13.92,
"end": 15.82,
"text": "महीने की पेली तारिक ती"
},
{
"start": 17.18,
"end": 18.62,
"text": "सुबा के 9 बजे"
},
{
"start": 20.0,
"end": 21.74,
"text": "अमित का पून पे एक असमे साया?"
},
{
"start": 23.0,
"end": 24.64,
"text": "एक लाख बेट प्री तेदें"
},
{
"start": 25.64,
"end": 26.28,
"text": "अब यह त्मुस्क्राया"
},
{
"start": 27.48,
"end": 29.26,
"text": "जाई कगगग उठाया और सोचा"
},
{
"start": 30.16,
"end": 31.5,
"text": "ู้ऄ बद्रबाशी मैंगध काशी।"
},
{
"start": 33.36,
"end": 34.8,
"text": "फिर आई बच्छी स्टादिक"
},
{
"start": 36.0,
"end": 36.56,
"text": "वही अमित"
},
{
"start": 37.34,
"end": 37.84,
"text": "वएईवोड"
},
{
"start": 38.98,
"end": 39.94,
"text": "उस में बलाँस देखा"
},
{
"start": 40.72,
"end": 44.06,
"text": "और एक सक्विन्ट की लिए बिल्कुं चुप बोगया"
},
{
"start": 45.86,
"end": 46.34,
"text": "उस्राद"
},
{
"start": 47.2,
"end": 47.8,
"text": "तारे के बाड़"
},
{
"start": 48.46,
"end": 50.06,
"text": "ने आने दीरे से पुचा"
},
{
"start": 51.1,
"end": 52.92,
"text": "आर्व्की खोलिष पिस्गा"
},
{
"start": 53.58,
"end": 54.38,
"text": "कुछ सोचाय."
},
{
"start": 55.26,
"end": 56.54,
"text": "और अपना कर"
},
{
"start": 57.34,
"end": 57.86,
"text": "पर लेंगे"
},
{
"start": 59.62,
"end": 60.46,
"text": "अब इत के पास"
},
{
"start": 61.08,
"end": 62.04,
"text": "कोई चवाब नहींता"
},
{
"start": 64.04,
"end": 64.36,
"text": "अगर"
},
{
"start": 64.98,
"end": 68.26,
"text": "ये बात आदके गर मे भी कभी ना कभी"
},
{
"start": 68.96,
"end": 69.28,
"text": "वूईेः"
},
{
"start": 69.98,
"end": 72.2,
"text": "तो ये तहानी आपकी भी है"
},
{
"start": 74.6,
"end": 75.48,
"text": "मैं हु राजि"
},
{
"start": 76.22,
"end": 80.48,
"text": "ये है मेल प्पास पंडि का आद."
},
{
"start": 81.12,
"end": 83.66,
"text": "money plan । part 1"
},
{
"start": 84.32,
"end": 85.54,
"text": "तो आई ये समचते हैं"
},
{
"start": 86.36,
"end": 92.76,
"text": "हम कैसे, बजजट से, इनवेस्मेंतर, गर से, रेटारमेंतर, सब कुछ"
},
{
"start": 93.5,
"end": 94.74,
"text": "अस्दान ब्हासा में"
},
{
"start": 95.86,
"end": 96.5,
"text": "और इस"
},
{
"start": 97.26,
"end": 101.5,
"text": "पूरी सिरिज में हम एक ही फम्ली के साथ चरेंगे"
},
{
"start": 102.36,
"end": 106.32,
"text": "उनकी हर वुस्किल और हर प्राइसले के साथ"
},
{
"start": 109.18,
"end": 110.36,
"text": "तो मिलते है"
},
{
"start": 111.06,
"end": 111.46,
"text": "बर्वाँ"
},
{
"start": 112.08,
"end": 112.52,
"text": "॥ ु ृ ै ृ । । । ू"
},
{
"start": 113.78,
"end": 118.18,
"text": "लक्नाँ में एक किराए के तू भीज्के गर में ये फाँईम्नी जेती है"
},
{
"start": 119.38,
"end": 122.18,
"text": "अमित जो लगबब प्याटिष साल कि हैं"
},
{
"start": 122.84,
"end": 124.38,
"text": "और एक प्राविट कम्प्री में"
},
{
"start": 125.1,
"end": 125.48,
"text": "काम करते"
},
{
"start": 126.78,
"end": 127.24,
"text": "मिहा"
},
{
"start": 128.28,
"end": 129.92,
"text": "ताएतिस की है और"
},
{
"start": 130.7,
"end": 133.44,
"text": "शाम को गर पे बच्छो को"
},
{
"start": 134.12,
"end": 134.9,
"text": "कि विज़ें पाला तिजे"
},
{
"start": 137.96,
"end": 140.0,
"text": "उनके वो बट्चे हैं"
},
{
"start": 140.82,
"end": 141.26,
"text": "अद"
},
{
"start": 141.94,
"end": 143.28,
"text": "जो आट सल का है"
},
{
"start": 144.28,
"end": 146.14,
"text": "और ख्रिकेट कर दिवाना है"
},
{
"start": 147.18,
"end": 149.1,
"text": "और जोटी पिहु सिद"
},
{
"start": 149.76,
"end": 150.48,
"text": "चाँ साल की है!"
},
{
"start": 152.14,
"end": 158.22,
"text": "दोनुक ती कबाई मिलादे गर में हर महीने एक लाग आता है"
},
{
"start": 159.9,
"end": 160.86,
"text": "ये प्रम्ली"
},
{
"start": 161.84,
"end": 166.6,
"text": "अस्ली नहीं है, एक एकजामपल है, लेकिन मुझे यकीन है"
},
{
"start": 167.58,
"end": 170.36,
"text": "कही ना कही आपको इने में अपने फाँम्मी दिके ही"
},
{
"start": 173.22,
"end": 175.14,
"text": "इक संदे की तोपर"
},
{
"start": 176.12,
"end": 181.24,
"text": "अर्दित अर्नेहा निप दिशाइत किया कि आज पुरा इसाब लगाईने"
},
{
"start": 183.48,
"end": 184.5,
"text": "सेविंगे गाँए खोला"
},
{
"start": 185.52,
"end": 186.16,
"text": "उस्में ताँ"
},
{
"start": 186.82,
"end": 188.18,
"text": "60 Rs"
},
{
"start": 189.44,
"end": 191.62,
"text": "साद में अवित्खा इप्यप्ता."
},
{
"start": 192.3,
"end": 194.36,
"text": "और तम्प्रिक्टा हेल्टींसे अरेस्वीं"
},
{
"start": 195.52,
"end": 197.0,
"text": "ने हा, कुस वो भी?"
},
{
"start": 197.94,
"end": 202.72,
"text": "देखु ना कोई लोग नहीं है हमारे अपर ना केट काट का बिल"
},
{
"start": 203.56,
"end": 205.18,
"text": "अं तो थीटाए तो रहे है"
},
{
"start": 206.46,
"end": 208.22,
"text": "और जब अमित"
},
{
"start": 208.9,
"end": 216.0,
"text": "में गर का ज़र्वी खचा जोडा तो वही अंथावन हचार महीना पिकला"
},
{
"start": 216.96,
"end": 219.64,
"text": "मतलव, में सात हाजार बस"
},
{
"start": 220.46,
"end": 222.12,
"text": "एक महीने का सहारा है"
},
{
"start": 223.12,
"end": 226.48,
"text": "अगर कोदाना काच्ता कर जाए जली जाए"
},
{
"start": 227.3,
"end": 229.18,
"text": "तो दुस्रे मेंने क्या होगा?"
},
{
"start": 231.58,
"end": 234.86,
"text": "तो आबित ने अपनी पुरानी डाईरी निकानी"
},
{
"start": 236.18,
"end": 237.7,
"text": "और तो लोग देखा"
},
{
"start": 238.64,
"end": 241.88,
"text": "सुरूक्या की ये एक लाग आखिद चाटा काहाँ है"
},
{
"start": 244.78,
"end": 246.08,
"text": "सबसे बड़ा कच्वता"
},
{
"start": 246.72,
"end": 249.38,
"text": "भी दाया जोगी अखार वाजा दूबे हैं"
},
{
"start": 251.32,
"end": 253.76,
"text": "वाश़ यो की चाँदा हजार महीने काई तुछ वाश़ यो की चाँदा हजार महीने काई तुछ"
},
{
"start": 254.76,
"end": 259.7,
"text": "बिज्ली पानी अंट्रेट्ग़ भिल यस सब मिलाके महीने कचार खचार"
},
{
"start": 260.48,
"end": 265.04,
"text": "और अने जाने का ख़ास्पोटेशन का खच्चा भी लब वर चे हजार मेंगे का"
},
{
"start": 266.1,
"end": 268.94,
"text": "तो बज़़ का खच्या तस खच्या तोन बच्यो का"
},
{
"start": 269.62,
"end": 272.94,
"text": "और सात में दवाई हेल्ट का चेहजाई का करच्चा"
},
{
"start": 273.62,
"end": 279.78,
"text": "तो तोटल किया तो सर्फ ज़रूरी चीजो पही अंटावर हाजार चले जादे थे"
},
{
"start": 281.16,
"end": 285.78,
"text": "फिर निया को याज आया, और वो कछ में, जो आचान का जाते हैं।"
},
{
"start": 286.54,
"end": 288.48,
"text": "ज़से की अवी दिमाली आ़ी आ़ी है"
},
{
"start": 290.04,
"end": 291.52,
"text": "कही बच्छो ओड़े"
},
{
"start": 292.2,
"end": 295.64,
"text": "कोर्स ते अदमिशन कार्वाए, किसी रिस्टिदार के सादी के लिए किप्लिनाए."
},
{
"start": 296.58,
"end": 297.14,
"text": "अदिखासा"
},
{
"start": 297.82,
"end": 300.6,
"text": "वो आचानक नहीं रापे, ये तो रब चाल आपे."
},
{
"start": 301.22,
"end": 304.08,
"text": "तो उनके लिए हर मेंने चेहें हैं अलक से लखने हूंगे"
},
{
"start": 304.84,
"end": 306.96,
"text": "और तोरी मस्तिक तो जाएगे वीकेंपे"
},
{
"start": 307.88,
"end": 310.54,
"text": "तो उसके लिए पाज़े लग से लखने होगे हैं और मेंने"
},
{
"start": 311.46,
"end": 315.52,
"text": "और ज़़ा वो ता एकतिस रख्चार ब्रुपें"
},
{
"start": 316.72,
"end": 319.8,
"text": "उस्में से 8,000 इमरजंशी प्र्ड्ट के लेए चाही।"
},
{
"start": 320.58,
"end": 330.6,
"text": "तेरा हाजार रेदारमिद के लेजाए और दस हजार बच्छों के पड़ाई के लेजा जब उआर्मेचल के यिन्वोसिट्टी में या कही बड़ेद खोलेद्द पड़ाई चाए."
},
{
"start": 331.42,
"end": 336.54,
"text": "नियाने गरु से का एक वटिस पस्विंट बच्छत हूंत खाफी अच्छा गर रहें।"
},
{
"start": 337.86,
"end": 338.46,
"text": "अबितने"
},
{
"start": 339.6,
"end": 341.12,
"text": "रामे श्वर्खिलाया"
},
{
"start": 342.92,
"end": 344.12,
"text": "मन में एक सवाल ठा"
},
{
"start": 345.2,
"end": 346.86,
"text": "या ये सच में काफी हैं"
},
{
"start": 348.88,
"end": 350.26,
"text": "उस्राद बच्छुड"
},
{
"start": 350.94,
"end": 356.26,
"text": "के सोने के बाद तोनोंने एक कागिज लिया और अपने सारे सबने"
},
{
"start": 356.98,
"end": 358.3,
"text": "एक लाई में निग दिया"
},
{
"start": 360.34,
"end": 360.76,
"text": "सबसे प्रणे"
},
{
"start": 361.58,
"end": 362.36,
"text": "इमर्जन्सीवाः"
},
{
"start": 363.36,
"end": 364.58,
"text": "जो अगी चाएएः"
},
{
"start": 365.84,
"end": 369.86,
"text": "तर्द इंसोरेंज लिएद इंसोरेंज वो भी चेक्या वो भी अभी अभी चाएएज़।"
},
{
"start": 370.8,
"end": 373.02,
"text": "आर्व के कोलिज लगम दस साल में आए गा."
},
{
"start": 373.8,
"end": 375.4,
"text": "और पीवुका च्योगा सालने"
},
{
"start": 376.48,
"end": 378.6,
"text": "अड़ार्विन पीपच्छिस्शा बाडाया"
},
{
"start": 379.9,
"end": 383.24,
"text": "और आमित के ममी पपा का भी कीर करना है"
},
{
"start": 383.86,
"end": 388.06,
"text": "उसकी भी ज़रत तो कभी नकभी पर सकती हैं क्योंके वो भी एजिन हो रहें"
},
{
"start": 389.32,
"end": 390.6,
"text": "तिर निया निगा"
},
{
"start": 391.74,
"end": 393.22,
"text": "और हमारा अपना गर"
},
{
"start": 394.42,
"end": 395.84,
"text": "और उत्स्के साँने बसृअ"
},
{
"start": 396.56,
"end": 396.92,
"text": "इप्माँ"
},
{
"start": 397.86,
"end": 399.32,
"text": "कभी ना कभी"
},
{
"start": 400.3,
"end": 402.0,
"text": "और यही आस्ली प्रव्लड़व है"
},
{
"start": 403.16,
"end": 405.68,
"text": "रर गोल की अपनी देडलाईग आप"
},
{
"start": 406.42,
"end": 409.06,
"text": "और सब एक साथ दस्टर्भेरे हैं"
},
{
"start": 411.3,
"end": 413.62,
"text": "अवित ने पोड का खाल्ट्मिट्र कोला"
},
{
"start": 415.0,
"end": 417.94,
"text": "परहाई किलिए 10,000 रहाई नहींगे"
},
{
"start": 418.66,
"end": 421.66,
"text": "10 साल तक मतल 12 लाक्ड़ुबे"
},
{
"start": 422.94,
"end": 425.84,
"text": "और तो बच्चों के लिए मिल्के है"
},
{
"start": 427.2,
"end": 431.96,
"text": "रेदायमड के ले 13 रच्चार एर महीने जो की 25 साँ तक"
},
{
"start": 432.76,
"end": 434.76,
"text": "उन जालिस नाक बवे हो जाता."
},
{
"start": 436.16,
"end": 438.16,
"text": "नम्वर तो बगड़े लगे हैं अवी"
},
{
"start": 438.86,
"end": 441.44,
"text": "लेकि ये सेर्व चमा रकम है"
},
{
"start": 442.44,
"end": 443.98,
"text": "इस में ना ग्रोट जुलिय है"
},
{
"start": 444.6,
"end": 447.52,
"text": "ना महंगाई जुडी हैं ना इंटिखलेशन जुडा हैं"
},
{
"start": 448.48,
"end": 452.2,
"text": "कौलेज का असली कखचा तब कितना होगा वो हम"
},
{
"start": 453.02,
"end": 457.26,
"text": "अपीसुड नमबर फ़टिवाल और फ़टिशक्स में मिल के निकालते हैं"
},
{
"start": 459.0,
"end": 460.52,
"text": "और उस्राथ आमित्खो"
},
{
"start": 461.38,
"end": 462.74,
"text": "ये बाद तो समच आगे"
},
{
"start": 463.44,
"end": 470.56,
"text": "जो प्यसाँ एक साल में चाहिये और जो प्यसिस साल माड चाहिये उनका प्लान एक जैसा अगुए।"
},
{
"start": 471.38,
"end": 471.86,
"text": "वो वी नेज़ा"
},
{
"start": 473.48,
"end": 476.2,
"text": "रह्गोल को अपना अलग बकेट चाहगी"
},
{
"start": 477.94,
"end": 480.06,
"text": "गोल प्लस देडनाई"
},
{
"start": 481.02,
"end": 482.34,
"text": "तब बन ता है ब्लाँ"
},
{
"start": 483.34,
"end": 485.22,
"text": "और सुर्वाद कहाँ से?"
},
{
"start": 486.38,
"end": 487.24,
"text": "तबसे फहला"
},
{
"start": 487.92,
"end": 488.22,
"text": "सिब्टी"
},
{
"start": 489.7,
"end": 491.34,
"text": "तिसकिलिया को इमजेंसी पन"
},
{
"start": 492.44,
"end": 494.26,
"text": "उस्यिक।"
},
{
"start": 495.16,
"end": 498.66,
"text": "और तुए कोई भी नहेंगा करच ड़ें तो उकब खतम हो जाना चाही।"
},
{
"start": 499.46,
"end": 501.0,
"text": "उसके बाडा तहल्लंबर्बूं"
},
{
"start": 501.74,
"end": 504.46,
"text": "और ये सीरिज़़ भी बिल्खुल इसी रास्टे पी चलीगी"
},
{
"start": 505.78,
"end": 507.28,
"text": "अब बारी आप गीए."
},
{
"start": 508.58,
"end": 511.38,
"text": "आज राद नहां कितरा एक कागेज लिजिये"
},
{
"start": 512.04,
"end": 514.56,
"text": "और अपनी फ्यम्लिक पाज गोल्स लिकिये"
},
{
"start": 516.08,
"end": 518.48,
"text": "हर गुल के सामने तोए की जे"
},
{
"start": 519.28,
"end": 519.6,
"text": "वो"
},
{
"start": 520.42,
"end": 522.94,
"text": "कर चाही एं और लगबबड तिप्मा"
},
{
"start": 524.06,
"end": 524.88,
"text": "अंदार भी च़ेगा"
},
{
"start": 526.12,
"end": 526.82,
"text": "और अगर"
},
{
"start": 527.5,
"end": 530.68,
"text": "तिसी गोल्ता साँ लिक रही नहीं पार है हो"
},
{
"start": 531.62,
"end": 532.36,
"text": "तो समज लिए दा"
},
{
"start": 533.02,
"end": 534.28,
"text": "वो अभी गोली"
},
{
"start": 535.7,
"end": 535.98,
"text": "सब माई"
},
{
"start": 537.34,
"end": 539.74,
"text": "अउपात नहीं. उसे रड लिक ऱीग ऱीग में."
},
{
"start": 541.46,
"end": 542.36,
"text": "अगली पार्ट में"
},
{
"start": 543.56,
"end": 544.36,
"text": "अंदेखेंगे ती"
},
{
"start": 545.04,
"end": 547.1,
"text": "अमित की सेलरी आती तो है"
},
{
"start": 548.16,
"end": 550.14,
"text": "और फेल तायक तहाँ पोज़ाते"
},
{
"start": 553.68,
"end": 554.0,
"text": "तब तख"
},
{
"start": 555.24,
"end": 556.12,
"text": "कमें में बरताइगे"
},
{
"start": 556.82,
"end": 560.3,
"text": "अपकी फम्लिका सबसे बड़ा गोल क्या है"
},
{
"start": 562.56,
"end": 563.14,
"text": "याद हैं"
},
{
"start": 563.8,
"end": 564.28,
"text": "ये येट"
},
{
"start": 564.88,
"end": 566.64,
"text": "अदुकिशना इज़्ाम्पले"
},
{
"start": 567.84,
"end": 569.76,
"text": "गवई प्रणश्यों तर वाईजनी"
},
{
"start": 571.1,
"end": 574.92,
"text": "अगर आपको एक EI based financial planner"
},
{
"start": 575.7,
"end": 578.14,
"text": "जाएए तो वीजिट करो हमारा वेब साइत"
},
{
"start": 579.02,
"end": 580.88,
"text": "समजो वित्राज डोड अन्लेंग पें"
},
{
"start": 582.04,
"end": 584.42,
"text": "मिलते हैं पार्टूमें"
}
